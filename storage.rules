rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Profile pictures are kept under profile_pictures/{uid}/{fileName}
    // and optionally legacy profile_pictures/{uid}.jpg.
    match /profile_pictures/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow write, delete: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /profile_pictures/{legacyFile} {
      allow read: if request.auth != null;
      allow write, delete: if request.auth != null
        && legacyFile == request.auth.uid + '.jpg'
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}