rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isCurrentUser(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isParticipantByList(participants) {
      return isSignedIn() && participants is list && request.auth.uid in participants;
    }

    function isLegacyOwner(data) {
      return isSignedIn() && data is map &&
        (
          ('ownerId' in data && data.ownerId == request.auth.uid) ||
          ('createdBy' in data && data.createdBy == request.auth.uid) ||
          ('uid' in data && data.uid == request.auth.uid)
        );
    }

    function isHabitParticipant() {
      return resource.data is map &&
        (('participants' in resource.data && isParticipantByList(resource.data.participants)) ||
          isLegacyOwner(resource.data));
    }

    function isGroupMember() {
      return isSignedIn() && resource.data is map &&
        (
          ('memberIds' in resource.data && resource.data.memberIds is list && request.auth.uid in resource.data.memberIds) ||
          ('participants' in resource.data && resource.data.participants is list && request.auth.uid in resource.data.participants) ||
          ('ownerId' in resource.data && resource.data.ownerId == request.auth.uid)
        );
    }

    function parentGroupAllowsAccess(groupId) {
      let groupPath = /databases/$(database)/documents/groups/$(groupId);
      let group = exists(groupPath) ? get(groupPath).data : {};
      return isSignedIn() && group is map &&
        (
          ('memberIds' in group && group.memberIds is list && request.auth.uid in group.memberIds) ||
          ('participants' in group && group.participants is list && request.auth.uid in group.participants) ||
          ('ownerId' in group && group.ownerId == request.auth.uid)
        );
    }

    function canSelfJoinGroup() {
      return isSignedIn() && resource.data is map &&
        request.resource.data.memberIds is list &&
        request.resource.data.memberIds.hasAny([request.auth.uid]) &&
        request.resource.data.diff(resource.data).changedKeys().hasOnly(['memberIds']);
    }

    function canOnlyChangeStatus() {
      return resource.data is map &&
        request.resource.data.diff(resource.data).changedKeys().hasOnly(['status']);
    }

    function isRecipientOrSender(fromField, toField) {
      return isSignedIn() && resource.data is map &&
        (resource.data[fromField] == request.auth.uid || resource.data[toField] == request.auth.uid);
    }

    function canUpdateReciprocalFriendList() {
      return isSignedIn() &&
        resource.data is map &&
        request.resource.data.diff(resource.data).changedKeys().hasOnly(['friends']) &&
        request.resource.data.friends is list &&
        (
          (
            !('friends' in resource.data) &&
            request.resource.data.friends.hasOnly([request.auth.uid]) &&
            request.resource.data.friends.size() == 1
          ) ||
          (
            'friends' in resource.data &&
            resource.data.friends is list &&
            (
              request.resource.data.friends == resource.data.friends ||
              (
                !resource.data.friends.hasAny([request.auth.uid]) &&
                request.resource.data.friends.hasAll(resource.data.friends) &&
                request.resource.data.friends.hasAny([request.auth.uid]) &&
                request.resource.data.friends.size() == resource.data.friends.size() + 1
              ) ||
              (
                resource.data.friends.hasAny([request.auth.uid]) &&
                !request.resource.data.friends.hasAny([request.auth.uid]) &&
                resource.data.friends.hasAll(request.resource.data.friends) &&
                request.resource.data.friends.size() == resource.data.friends.size() - 1
              )
            )
          )
        );
    }

    match /users/{uid} {
      allow read: if isSignedIn();

      allow create: if isCurrentUser(uid);

      allow update: if isCurrentUser(uid) || canUpdateReciprocalFriendList();

      allow delete: if false;

      match /{allSubcollections=**} {
        allow read, write: if isCurrentUser(uid);
      }
    }

    match /habits/{habitId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn() &&
        request.resource.data.id == habitId &&
        isParticipantByList(request.resource.data.participants);

      allow update, delete: if isHabitParticipant() ||
        (
          isSignedIn() &&
          request.resource.data.participants is list &&
          request.resource.data.participants.hasAny([request.auth.uid]) &&
          request.resource.data.diff(resource.data).changedKeys().hasOnly(['participants'])
        );
    }

    match /friendRequests/{requestId} {
      allow read: if isRecipientOrSender('from', 'to');

      allow create: if isSignedIn() &&
        request.resource.data.from == request.auth.uid &&
        request.resource.data.to is string &&
        request.resource.data.to != request.auth.uid &&
        request.resource.data.status == 'pending';

      allow update: if isSignedIn() &&
        resource.data.to == request.auth.uid &&
        canOnlyChangeStatus() &&
        request.resource.data.status in ['accepted', 'declined'];

      allow delete: if false;
    }

    match /habitInvites/{inviteId} {
      allow read: if isRecipientOrSender('from', 'to');

      allow create: if isSignedIn() &&
        request.resource.data.from == request.auth.uid &&
        request.resource.data.to is string &&
        request.resource.data.to != request.auth.uid &&
        request.resource.data.habitId is string &&
        request.resource.data.status == 'pending';

      allow update: if isSignedIn() &&
        resource.data.to == request.auth.uid &&
        canOnlyChangeStatus() &&
        request.resource.data.status in ['accepted', 'declined'];

      allow delete: if false;
    }

    match /groupInvites/{inviteId} {
      allow read: if isRecipientOrSender('from', 'to');

      allow create: if isSignedIn() &&
        request.resource.data.from == request.auth.uid &&
        request.resource.data.to is string &&
        request.resource.data.to != request.auth.uid &&
        request.resource.data.groupId is string &&
        request.resource.data.status == 'pending';

      allow update: if isSignedIn() &&
        resource.data.to == request.auth.uid &&
        canOnlyChangeStatus() &&
        request.resource.data.status in ['accepted', 'declined'];

      allow delete: if false;
    }

    match /challengeInvites/{inviteId} {
      allow read: if isRecipientOrSender('from', 'to');

      allow create: if isSignedIn() &&
        request.resource.data.from == request.auth.uid &&
        request.resource.data.to is string &&
        request.resource.data.to != request.auth.uid &&
        request.resource.data.groupId is string &&
        request.resource.data.challengeId is string &&
        request.resource.data.status == 'pending';

      allow update: if isSignedIn() &&
        resource.data.to == request.auth.uid &&
        canOnlyChangeStatus() &&
        request.resource.data.status in ['accepted', 'declined'];

      allow delete: if false;
    }

    match /habitNotices/{noticeId} {
      allow read: if isSignedIn() && resource.data.to == request.auth.uid;

      allow create: if isSignedIn() &&
        request.resource.data.from == request.auth.uid &&
        request.resource.data.to is string &&
        request.resource.data.habitId is string &&
        request.resource.data.status == 'unread' &&
        exists(/databases/$(database)/documents/habits/$(request.resource.data.habitId)) &&
        get(/databases/$(database)/documents/habits/$(request.resource.data.habitId)).data.participants.hasAll([
          request.auth.uid,
          request.resource.data.to,
        ]);

      allow update: if isSignedIn() &&
        resource.data.to == request.auth.uid &&
        request.resource.data.diff(resource.data).changedKeys().hasOnly(['status', 'notifiedAt']) &&
        request.resource.data.status in ['notified', 'read'];

      allow delete: if false;
    }

    match /groups/{groupId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn() &&
        request.resource.data.id == groupId &&
        request.resource.data.memberIds is list &&
        request.resource.data.memberIds.hasAny([request.auth.uid]);

      allow update: if isGroupMember() || canSelfJoinGroup();

      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;

      match /tasks/{taskId} {
        allow read: if isSignedIn();

        allow create, update, delete: if parentGroupAllowsAccess(groupId);
      }

      match /challenges/{challengeId} {
        allow read: if isSignedIn();

        allow create, update, delete: if parentGroupAllowsAccess(groupId);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
